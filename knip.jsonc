{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // The scripts' entry points are found through the package.json scripts
      // and their tests through the root Vitest config's `scripts` project.
      "project": ["*.config.ts", "scripts/**/*.ts"]
    },
    "packages/*": {
      // Entries come from each package's tsdown config (knip's tsdown
      // plugin). Type tests are run by Vitest's typecheck mode, which the
      // vitest plugin does not read; list them so they are not reported as
      // unused.
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/paraglide-intl": {
      // As packages/*; the compile tests' fixture projects load the
      // message-format plugin by path.
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@inlang/plugin-message-format"]
    },
    "e2e/*": {
      // Consumer packages: every test file is an entry (vitest plugin);
      // `support/` is reached from them. `smoke/run.ts` and `smoke/workerd.ts`
      // are found through the package.json scripts; `worker.ts` is a tsdown
      // entry named as a string inside `workerd.ts`, so it is listed.
      "entry": ["smoke/worker.ts"],
      "project": ["**/*.ts"]
    },
    "e2e/ban": {
      // As e2e/*, plus `node-types/`, which node-types.e2e.test.ts compiles
      // with tsc instead of importing.
      "entry": ["smoke/worker.ts", "node-types/*.ts"],
      "project": ["**/*.ts"]
    },
    "e2e/intl": {
      // As e2e/*; the compiled fixture projects load the message-format
      // plugin by path.
      "entry": ["smoke/worker.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@inlang/plugin-message-format"]
    },
    "e2e/jsonapi": {
      // As e2e/*, plus `declarations/`: modules declarations.e2e.test.ts
      // compiles with tsc to emit their declarations, so all of their
      // exports are public; `node-types/`, which node-types.e2e.test.ts
      // compiles with tsc; and `query/adapters/`, which only the type check
      // reads. The adapters are TypeScript, with no `.vue` or `.svelte`
      // components, so the Vue and Svelte plugins, which the `vue` and
      // `svelte` dependencies enable along with their compilers, are turned
      // off here.
      // @ref https://knip.dev/reference/configuration#plugins ("Disable a plugin by setting its value to `false`"; per workspace)
      // @ref https://knip.dev/features/compilers ("Compilers are enabled only when a related dependency is found")
      "entry": [
        "smoke/worker.ts",
        "declarations/*.ts",
        "node-types/*.ts",
        "query/adapters/*.ts"
      ],
      "project": ["**/*.ts"],
      "svelte": false,
      "vue": false
    },
    "e2e/catalog": {
      // As e2e/*, plus the generated files under `fixtures/*/expected/`:
      // modules an application imports, so all of their exports are public.
      "entry": ["smoke/worker.ts", "fixtures/*/expected/*.ts"],
      "project": ["**/*.ts"]
    },
    "e2e/resource": {
      // As e2e/*, plus: the generated catalogs (all exports public); the
      // extraction config the pg-catalog bin loads; `fails/`, which
      // fails.e2e.test.ts compiles with tsc instead of importing, and
      // `declarations/`, which declaration-emit.e2e.test.ts compiles to emit
      // declarations; and `localization/transform-forms.ts` and
      // `form/adapters/`, which only the type check reads. The adapters and
      // the Vue screen (`vue/`) are TypeScript, with no `.vue` or `.svelte`
      // components, so the Vue and Svelte plugins are turned off here, as
      // for e2e/jsonapi. The inlang project loads the message-format plugin
      // by path, and `@angular/common` is a peer of
      // `@tanstack/angular-store`, which Angular Form depends on, declared
      // so it installs at the release of `@angular/core` it requires
      // exactly.
      "entry": [
        "smoke/worker.ts",
        "fixtures/*/*catalog.ts",
        "fixtures/*/pg-catalog.config.mjs",
        "fails/*.ts",
        "declarations/*.ts",
        "localization/transform-forms.ts",
        "form/adapters/*.ts"
      ],
      "project": ["**/*.{ts,tsx}", "**/*.mjs"],
      "ignoreDependencies": [
        "@inlang/plugin-message-format",
        "@angular/common"
      ],
      "svelte": false,
      "vue": false
    }
  }
}
