{
  "name": "@nizam-os/kysely-resource",
  "version": "0.0.0",
  "description": "The Kysely runtime for @nizam-os/resource-core declarations on PostgreSQL: a storage adapter that sends and reads every value as text, scoped transactions inside row security, boot checks against the catalog and the connection, and a transactional outbox.",
  "keywords": [
    "json-api",
    "kysely",
    "multi-tenant",
    "outbox",
    "postgres",
    "postgresql",
    "rls",
    "row-level-security"
  ],
  "homepage": "https://github.com/nizam-os/kit/tree/main/packages/kysely-resource#readme",
  "bugs": "https://github.com/nizam-os/kit/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizam-os/kit.git",
    "directory": "packages/kysely-resource"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nizam-os/ban-core": "workspace:^",
    "@nizam-os/catalog-core": "workspace:^",
    "@nizam-os/jsonapi-core": "workspace:^",
    "@nizam-os/kysely-keyset": "workspace:^"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@nizam-os/keyset-core": "workspace:^",
    "@nizam-os/pg-catalog": "workspace:^",
    "@nizam-os/resource-core": "workspace:^",
    "kysely": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@nizam-os/keyset-core": "^0.1.0",
    "@nizam-os/resource-core": "^0.1.0",
    "kysely": ">=0.29.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
