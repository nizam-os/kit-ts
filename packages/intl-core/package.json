{
  "name": "@nizam-os/intl-core",
  "version": "0.1.0",
  "description": "Hydration-safe formatting for any JavaScript runtime: formatters that read the locale and the reader's time zone on every call through cached Intl objects built for pinned formatting tags, the reader's time zone from a cookie, and Unicode bidi isolation. No dependencies.",
  "keywords": [
    "bidi",
    "formatting",
    "hydration",
    "i18n",
    "intl",
    "paraglide",
    "ssr",
    "time-zone"
  ],
  "homepage": "https://github.com/nizam-os/kit-ts/tree/main/packages/intl-core#readme",
  "bugs": "https://github.com/nizam-os/kit-ts/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizam-os/kit-ts.git",
    "directory": "packages/intl-core"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
