{
  "name": "@nizam-os/kit-ts",
  "version": "0.0.0",
  "private": true,
  "description": "The Nizam Kit packages: structured HTTP errors (ban), the PostgreSQL schema as a typed catalog (catalog), JSON:API 1.1 (jsonapi), and keyset pagination (keyset), each a framework-free core with bindings for a host.",
  "homepage": "https://github.com/nizam-os/kit-ts#readme",
  "bugs": "https://github.com/nizam-os/kit-ts/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizam-os/kit-ts.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./e2e/**\" run build",
    "changeset": "changeset",
    "check": "pnpm run --sequential \"/^check:/\"",
    "audit:floors": "node --experimental-strip-types scripts/peer-floors/audit-advisories.ts",
    "check:deps": "knip",
    "check:floors": "node --experimental-strip-types scripts/peer-floors/check-jobs.ts",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:pkg": "pnpm -r --filter \"./packages/**\" run check:pkg",
    "check:types": "tsc --noEmit && pnpm -r --filter \"./packages/**\" run typecheck",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "release:pack": "node --experimental-strip-types scripts/release/pack.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && pnpm -r --workspace-concurrency=1 --filter \"./e2e/**\" run typecheck && pnpm -r --workspace-concurrency=1 --filter \"./e2e/**\" run test",
    "test:runtimes": "pnpm run build && pnpm -r --workspace-concurrency=1 --filter \"./e2e/**\" run smoke:bun && pnpm -r --workspace-concurrency=1 --filter \"./e2e/**\" run smoke:deno && pnpm -r --workspace-concurrency=1 --filter \"./e2e/**\" run smoke:workerd",
    "test:watch": "vitest",
    "typecheck": "pnpm run check:types"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "semver": "7.8.5",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.11.2"
}
