{
  "name": "@nizam-os/resource-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests: a consumer of the built @nizam-os/resource-core, declaring resources over the public catalog @nizam-os/pg-catalog extracts from a realistic application's migrations.",
  "type": "module",
  "scripts": {
    "build": "paraglide-js compile --project ./localization/project.inlang --outdir ./localization/paraglide --strategy preferredLanguage baseLocale --emit-ts-declarations --silent",
    "smoke:bun": "bun run smoke/run.ts",
    "smoke:deno": "deno run --allow-read --allow-env smoke/run.ts",
    "smoke:workerd": "node --experimental-strip-types smoke/workerd.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "write:catalogs": "node --experimental-strip-types scripts/write-catalogs.ts"
  },
  "devDependencies": {
    "@angular/common": "catalog:",
    "@angular/core": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@nizam-os/ban-core": "workspace:*",
    "@nizam-os/catalog-core": "workspace:*",
    "@nizam-os/hono-ban": "workspace:*",
    "@nizam-os/hono-jsonapi": "workspace:*",
    "@nizam-os/hono-resource": "workspace:*",
    "@nizam-os/jsonapi-client": "workspace:*",
    "@nizam-os/jsonapi-core": "workspace:*",
    "@nizam-os/keyset-core": "workspace:*",
    "@nizam-os/kysely-resource": "workspace:*",
    "@nizam-os/pg-catalog": "workspace:*",
    "@nizam-os/resource-core": "workspace:*",
    "@nizam-os/resource-ui": "workspace:*",
    "@nizam-os/tanstack-form-resource": "workspace:*",
    "@nizam-os/tanstack-query-jsonapi": "workspace:*",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@tanstack/angular-form": "1.33.5",
    "@tanstack/form-core": "catalog:",
    "@tanstack/lit-form": "1.25.5",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/solid-form": "1.33.5",
    "@tanstack/svelte-form": "1.33.5",
    "@tanstack/vue-form": "1.33.5",
    "@tanstack/vue-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "hono": "catalog:",
    "jsdom": "catalog:",
    "kysely": "catalog:",
    "lit": "3.3.3",
    "miniflare": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rxjs": "catalog:",
    "solid-js": "catalog:",
    "svelte": "catalog:",
    "tsdown": "catalog:",
