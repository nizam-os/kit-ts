{
  "name": "@nizam-os/tanstack-query-jsonapi",
  "version": "0.1.0",
  "description": "TanStack Query options for @nizam-os/jsonapi-client's calls, for every adapter: keys that are the request each call sends, reads that pass the query's signal, infinite lists by the server's links, writes that stay pending until what they changed has refetched, and Atomic Operations as one mutation.",
  "keywords": [
    "atomic-operations",
    "cursor-pagination",
    "json-api",
    "jsonapi",
    "query-core",
    "tanstack-query"
  ],
  "homepage": "https://github.com/nizam-os/kit-ts/tree/main/packages/tanstack-query-jsonapi#readme",
  "bugs": "https://github.com/nizam-os/kit-ts/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizam-os/kit-ts.git",
    "directory": "packages/tanstack-query-jsonapi"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nizam-os/jsonapi-client": "workspace:^",
    "@nizam-os/jsonapi-core": "workspace:^",
    "@tanstack/query-core": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nizam-os/jsonapi-client": "^0.1.0",
    "@tanstack/query-core": "^5.89.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
