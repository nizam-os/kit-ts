{
  "name": "@nizam-os/ban-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests: a consumer of the built @nizam-os/ban-core and @nizam-os/hono-ban packages, exercised over real HTTP.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "smoke:bun": "bun run smoke/run.ts",
    "smoke:deno": "deno run --allow-read --allow-env smoke/run.ts",
    "smoke:workerd": "node --experimental-strip-types smoke/workerd.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/standard-validator": "catalog:",
    "@hono/valibot-validator": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@nizam-os/ban-core": "workspace:*",
    "@nizam-os/hono-ban": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "drizzle-orm": "0.45.3",
    "hono": "catalog:",
    "miniflare": "catalog:",
    "pg": "catalog:",
    "postgres": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
