{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Resolve `@nizam-os/jsonapi-client`, and the core it builds on, to their
    // source through the `source` condition of their exports maps (written by
    // tsdown's `devExports`), so the options type-check against the client as
    // it is edited, without a build in between. Consumers, e2e/jsonapi/
    // included, never see the condition.
    // @ref https://tsdown.dev/options/package-exports#devexports
    // @ref https://www.typescriptlang.org/tsconfig/#customConditions
    "customConditions": ["source"]
  },
  "include": ["src/**/*.ts", "*.config.ts"],
  "exclude": ["dist", "node_modules", "coverage"]
}
