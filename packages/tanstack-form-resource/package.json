{
  "name": "@nizam-os/tanstack-form-resource",
  "version": "0.0.0",
  "description": "TanStack Form options and refusals for @nizam-os/resource-ui's form models, for every adapter: a form's values and validator from the model, and a refused write's texts on their fields.",
  "keywords": [
    "form-core",
    "forms",
    "json-api",
    "jsonapi",
    "tanstack-form"
  ],
  "homepage": "https://github.com/nizam-os/kit/tree/main/packages/tanstack-form-resource#readme",
  "bugs": "https://github.com/nizam-os/kit/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizam-os/kit.git",
    "directory": "packages/tanstack-form-resource"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nizam-os/jsonapi-client": "workspace:^",
    "@nizam-os/resource-core": "workspace:^",
    "@nizam-os/resource-ui": "workspace:^",
    "@tanstack/form-core": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@nizam-os/resource-ui": "^0.1.0",
    "@tanstack/form-core": "^1.17.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/form-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
