{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Resolve `@nizam-os/jsonapi-core` to its source through the `source`
    // condition of its exports map (written by tsdown's `devExports`), so the
    // client type-checks against the definitions as they are edited, without
    // a build in between. Consumers, e2e/jsonapi/ included, never see the
    // condition.
    // @ref https://tsdown.dev/options/package-exports#devexports
    // @ref https://www.typescriptlang.org/tsconfig/#customConditions
    "customConditions": ["source"]
  },
  "include": ["src/**/*.ts", "*.config.ts"],
  "exclude": ["dist", "node_modules", "coverage"]
}
