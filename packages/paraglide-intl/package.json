{
  "name": "@nizam-os/paraglide-intl",
  "version": "0.1.0",
  "description": "Paraglide JS messages whose interpolated values display in place in left-to-right and right-to-left text: compile() wraps every interpolation in Unicode isolates before Paraglide compiles the project. Re-exports @nizam-os/intl-core.",
  "keywords": [
    "bidi",
    "i18n",
    "inlang",
    "intl",
    "localization",
    "paraglide",
    "paraglide-js",
    "rtl"
  ],
  "homepage": "https://github.com/nizam-os/kit-ts/tree/main/packages/paraglide-intl#readme",
  "bugs": "https://github.com/nizam-os/kit-ts/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizam-os/kit-ts.git",
    "directory": "packages/paraglide-intl"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nizam-os/intl-core": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@inlang/plugin-message-format": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@inlang/paraglide-js": ">=2.11.0 <3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
