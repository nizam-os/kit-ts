{
  "name": "@nizam-os/pg-catalog",
  "version": "0.1.0",
  "description": "Your PostgreSQL schema as committed TypeScript: replays SQL migrations into PGlite or a throwaway database, reads pg_catalog, and writes a deterministic typed catalog of every table, column, constraint, index, policy, enum, and domain, with a browser-safe public slice.",
  "keywords": [
    "catalog",
    "codegen",
    "migrations",
    "pg-catalog",
    "pglite",
    "postgres",
    "postgresql",
    "schema"
  ],
  "homepage": "https://github.com/nizam-os/kit-ts/tree/main/packages/pg-catalog#readme",
  "bugs": "https://github.com/nizam-os/kit-ts/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizam-os/kit-ts.git",
    "directory": "packages/pg-catalog"
  },
  "bin": {
    "pg-catalog": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.mjs"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nizam-os/catalog-core": "workspace:^",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@nizam-os/resource-core": "workspace:^",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "kysely": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "@nizam-os/resource-core": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@nizam-os/resource-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
