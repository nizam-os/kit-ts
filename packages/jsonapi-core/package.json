{
  "name": "@nizam-os/jsonapi-core",
  "version": "0.0.0",
  "description": "JSON:API 1.1 for any JavaScript runtime: resource definitions, documents, query parsing, request parsing, content negotiation, the Cursor Pagination profile, and the Atomic Operations extension. Framework-free.",
  "keywords": [
    "atomic-operations",
    "cursor-pagination",
    "json-api",
    "jsonapi",
    "keyset",
    "rest",
    "sparse-fieldsets"
  ],
  "homepage": "https://github.com/nizam-os/kit/tree/main/packages/jsonapi-core#readme",
  "bugs": "https://github.com/nizam-os/kit/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizam-os/kit.git",
    "directory": "packages/jsonapi-core"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./atomic": {
      "source": "./src/atomic/index.ts",
      "default": "./dist/atomic.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./atomic": "./dist/atomic.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nizam-os/ban-core": "workspace:^"
  },
  "devDependencies": {
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
